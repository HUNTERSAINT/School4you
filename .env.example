# PostgreSQL (Railway can provide DATABASE_URL automatically)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/school4you"

# Authentication - generate a cryptographically random value of at least 32 characters
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Paystack (optional until payment gateway is activated)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Allow fee payments for schools without a Paystack subaccount (settles to the platform account). Leave unset in production.
PAYSTACK_ALLOW_PLATFORM_ACCOUNT=""

# Transactional email via Resend: verification and password-reset emails. Use a verified domain in EMAIL_FROM.
RESEND_API_KEY=""
EMAIL_FROM="School4you <noreply@example.com>"
