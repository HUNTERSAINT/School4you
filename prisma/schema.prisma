generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  BURSAR
  PARENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ResultStatus {
  DRAFT
  PUBLISHED
}

model School {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  email          String?
  phone          String?
  address        String?
  logoUrl        String?
  currency       String        @default("NGN")
  timezone       String        @default("Africa/Lagos")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  users          User[]
  classrooms     Classroom[]
  students       Student[]
  academicYears  AcademicYear[]
  terms          Term[]
  subjects       Subject[]
  feeInvoices    FeeInvoice[]
  payments       Payment[]
  attendance     AttendanceSession[]
  results        StudentResult[]
  auditLogs      AuditLog[]
}

model User {
  id           String    @id @default(cuid())
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(SCHOOL_ADMIN)
  isActive     Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  attendanceMarked AttendanceSession[] @relation("AttendanceMarker")
  resultsEntered   StudentResult[]     @relation("ResultEditor")
  auditLogs        AuditLog[]
  @@index([schoolId, role])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isCurrent Boolean  @default(false)
  terms     Term[]
  createdAt DateTime @default(now())
  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Term {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  startsAt       DateTime
  endsAt         DateTime
  isCurrent      Boolean      @default(false)
  feeInvoices    FeeInvoice[]
  results        StudentResult[]
  createdAt      DateTime     @default(now())
  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, isCurrent])
}

model Classroom {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  level     String?
  students  Student[]
  subjects  Subject[]
  createdAt DateTime  @default(now())
  @@unique([schoolId, name])
  @@index([schoolId])
}

model Student {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionNo   String
  firstName     String
  lastName      String
  middleName    String?
  dateOfBirth   DateTime?
  sex           String?
  stateOfOrigin String?
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  address       String?
  classroomId   String
  classroom     Classroom     @relation(fields: [classroomId], references: [id])
  status        StudentStatus @default(ACTIVE)
  enrolledAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  feeInvoices   FeeInvoice[]
  payments      Payment[]
  attendance    AttendanceRecord[]
  results       StudentResult[]
  @@unique([schoolId, admissionNo])
  @@index([schoolId, lastName, firstName])
  @@index([schoolId, classroomId, status])
}

model Subject {
  id          String      @id @default(cuid())
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  maxCaScore  Decimal     @default(30) @db.Decimal(5, 2)
  maxExamScore Decimal    @default(70) @db.Decimal(5, 2)
  results     StudentResult[]
  createdAt   DateTime    @default(now())
  @@unique([classroomId, name])
  @@index([schoolId, classroomId])
}

model FeeInvoice {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId         String
  term           Term          @relation(fields: [termId], references: [id], onDelete: Restrict)
  description    String        @default("School fees")
  amountDue      Decimal       @db.Decimal(12, 2)
  dueAt          DateTime?
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@unique([studentId, termId, description])
  @@index([schoolId, termId])
}

model Payment {
  id                String        @id @default(cuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceId         String
  invoice           FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  gateway           String        @default("PAYSTACK")
  gatewayReference  String        @unique
  gatewayPaymentId  String?
  paidAt            DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  @@index([schoolId, status, createdAt])
  @@index([studentId, invoiceId])
}

model AttendanceSession {
  id          String              @id @default(cuid())
  schoolId    String
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroomId String
  date        DateTime            @db.Date
  markedById  String
  markedBy    User                @relation("AttendanceMarker", fields: [markedById], references: [id])
  records     AttendanceRecord[]
  createdAt   DateTime            @default(now())
  @@unique([classroomId, date])
  @@index([schoolId, date])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(ABSENT)
  note      String?
  @@unique([sessionId, studentId])
  @@index([studentId])
}

model StudentResult {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  termId       String
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  caScore      Decimal      @default(0) @db.Decimal(5, 2)
  examScore    Decimal      @default(0) @db.Decimal(5, 2)
  totalScore   Decimal      @default(0) @db.Decimal(5, 2)
  grade        String?
  remark       String?
  status       ResultStatus @default(DRAFT)
  enteredById  String?
  enteredBy    User?        @relation("ResultEditor", fields: [enteredById], references: [id], onDelete: SetNull)
  updatedAt    DateTime     @updatedAt
  @@unique([studentId, subjectId, termId])
  @@index([schoolId, termId, studentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([schoolId, createdAt])
}
